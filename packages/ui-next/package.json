{
  "name": "@ejunz/ui-next",
  "version": "0.2.0",
  "author": "Jacka10086 <i@jacka10086.me>",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "index.ts",
  "types": "api.ts",
  "exports": {
    ".": {
      "types": "./api.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./api": {
      "types": "./api.ts",
      "import": "./api.ts",
      "default": "./api.ts"
    },
    "./renderer": {
      "types": "./src/renderer.ts",
      "import": "./src/renderer.ts",
      "default": "./src/renderer.ts"
    },
    "./app": {
      "types": "./src/app.tsx",
      "import": "./src/app.tsx",
      "default": "./src/app.tsx"
    },
    "./globals": {
      "types": "./src/globals.ts",
      "import": "./src/globals.ts",
      "default": "./src/globals.ts"
    },
    "./context/page-data": {
      "types": "./src/context/page-data.tsx",
      "import": "./src/context/page-data.tsx",
      "default": "./src/context/page-data.tsx"
    },
    "./registry/page": {
      "types": "./src/registry/page.tsx",
      "import": "./src/registry/page.tsx",
      "default": "./src/registry/page.tsx"
    },
    "./registry/layout": {
      "types": "./src/registry/layout.ts",
      "import": "./src/registry/layout.ts",
      "default": "./src/registry/layout.ts"
    },
    "./components/button": {
      "types": "./src/components/button.tsx",
      "import": "./src/components/button.tsx",
      "default": "./src/components/button.tsx"
    },
    "./components/callout": {
      "types": "./src/components/callout.tsx",
      "import": "./src/components/callout.tsx",
      "default": "./src/components/callout.tsx"
    },
    "./components/card": {
      "types": "./src/components/card.tsx",
      "import": "./src/components/card.tsx",
      "default": "./src/components/card.tsx"
    },
    "./components/field": {
      "types": "./src/components/field.tsx",
      "import": "./src/components/field.tsx",
      "default": "./src/components/field.tsx"
    },
    "./components/theme.css": "./src/components/theme.css",
    "./components/ui.css": "./src/components/ui.css",
    "./src/*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "preferUnplugged": true,
  "ejunz": {
    "cli": false
  },
  "files": [
    "index.ts",
    "api.ts",
    "css.d.ts",
    "src/",
    "locales/",
    "index.html",
    "public/",
    "vite.config.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.2.2",
    "cordis": "4.0.0-beta.5",
    "cssfilter": "^0.0.11",
    "esbuild": "0.25.2",
    "is-relative-url": "^4.1.0",
    "katex": "^0.16.25",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-merge-cells": "^2.0.0",
    "markdown-it-table-of-contents": "^1.1.0",
    "md-editor-rt": "^6.1.0",
    "path-to-regexp": "^8.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git": "^3.36.0",
    "viewerjs": "^1.11.7",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "koa2-connect": "^1.0.2",
    "vite": "^8.2.1"
  }
}
