    "./frontend/common.scss": "./frontend/web/common.scss",
    "./frontend/provider": "./frontend/web/provider.tsx",
    "./frontend/provider.tsx": "./frontend/web/provider.tsx",
    "./frontend/*": "./frontend/*"
