  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/jquery": "^3.5.32",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.20",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.93.2",
    "vue": "^3.5.18"
