    "./frontend/Icon.tsx": "./frontend/web/icon/Icon.tsx",
    "./frontend/Layout": "./frontend/shared/Layout.tsx",
    "./frontend/Layout.tsx": "./frontend/shared/Layout.tsx",
    "./frontend/Notification": "./frontend/web/notification/Notification.tsx",
