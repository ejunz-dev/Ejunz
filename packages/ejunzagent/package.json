{
  "name": "@ejunz/ea",
  "version": "0.1.2-rc.5",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "yarn@4.0.2",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "src/vendor/*",
    "src/*/*/*"
  ],
  "scripts": {
    "build": "yarn run build:lib && yarn run build:cli",
    "build:lib": "yarn run build:lib:host && yarn run build:lib:client",
    "build:cli-runtime": "tsx src/script/build-cli-runtime.ts",
    "build:lib:host": "tsc -b tsconfig.host.json && tsdown --env.EA_BUILD_FACE host",
    "build:lib:client": "tsc -b tsconfig.client.json && tsdown --env.EA_BUILD_FACE client",
    "clean": "tsx src/script/clean.ts",
    "change-scope": "tsx src/script/change-scope.ts",
    "typecheck": "yarn run build:lib:host && yarn run typecheck:contracts-ready",
    "typecheck:contracts-ready": "tsc -b tsconfig.client.json",
    "lint": "yarn run build:lib:host && yarn run lint:contracts-ready",
    "lint:contracts-ready": "tsx src/script/run-oxlint.ts .",
    "lint:fix": "yarn run build:lib:host && yarn run lint:fix:contracts-ready",
    "lint:fix:contracts-ready": "tsx src/script/run-oxlint.ts . --fix",
    "duplication": "jscpd --config .jscpd.json src/script",
    "migrate:packed-session-fixtures": "tsx src/script/migrate-packed-session-fixtures.ts",
    "knip": "knip --treat-config-hints-as-errors",
    "publint": "tsx src/script/publint-all.ts",
    "verify-package-paths": "tsx src/script/verify-package-paths.ts",
    "verify-ea-package-licenses": "tsx src/script/verify-ea-package-licenses.ts",
    "verify-config-source-ownership": "tsx src/script/verify-config-source-ownership.ts",
    "verify-package-invariants": "tsx src/script/verify-package-invariants.ts",
    "verify-built-package-invariants": "node src/script/verify-built-package-invariants.mjs",
    "verify-package-readme-model-experience": "tsx src/script/verify-package-readme-model-experience.ts",
    "verify-type-equiv": "tsx src/script/verify-type-equiv.ts",
    "verify-skill-invocation-metadata": "tsx src/script/verify-skill-invocation-metadata.ts",
    "verify-package-readme-limitations": "tsx src/script/verify-package-readme-limitations.ts",
    "verify-node-next-types": "tsx src/script/verify-node-next-types.ts",
    "verify-runtime-closure": "tsx src/script/verify-runtime-closure.ts",
    "verify-vendored-links": "tsx src/script/verify-vendored-links.ts",
    "rescope-vendor": "tsx src/script/rescope-vendor.ts",
    "rescope-vendor:check": "tsx src/script/rescope-vendor.ts --check",
    "verify-client-domain-graph": "tsx src/script/verify-client-domain-graph.ts",
    "verify-export-jsdoc": "tsx src/script/verify-export-jsdoc.ts",
    "constraints": "tsx src/script/check-workspace-constraints.ts",
    "hygiene": "yarn run rescope-vendor:check && yarn run knip && yarn run publint && yarn run constraints && yarn run verify-ea-package-licenses && yarn run verify-package-invariants && yarn run verify-built-package-invariants && yarn run verify-node-next-types && yarn run verify-runtime-closure && yarn run verify-vendored-links",
    "publish:npm-baseline": "tsx src/script/publish-npm-baseline.ts",
    "release:ea": "tsx src/script/release/bump.ts --family ea",
    "release:vendor": "tsx src/script/release/bump.ts --family vendor",
    "release:verify": "tsx src/script/release/verify.ts",
    "release:pack": "tsx src/script/release/pack.ts",
    "release:verify-packed-install": "tsx src/script/release/verify-packed-install.ts",
    "release:publish": "tsx src/script/release/publish.ts",
    "ea": "node --expose-internals --import tsx/esm src/entry/bin.ts",
    "postinstall": "node bin/postinstall.js",
    "agent": "yarn run ea node",
    "build:cli": "tsc -b tsconfig.cli.json && tsdown --config tsdown.cli.config.ts && yarn run build:cli-runtime"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@ejunz/agent": "workspace:^",
    "@ejunz/host-webserver": "workspace:^",
    "@ejunz/llm": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/settings": "workspace:^",
    "@ejunz/subagent": "workspace:^",
    "@ejunz/system-prompt": "workspace:^",
    "@ejunz/tool-session-query": "workspace:^",
    "@ejunz/tools": "workspace:^",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@yarnpkg/cli-dist": "4.17.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "execa": "^10.0.0",
    "fast-check": "^4.8.0",
    "istanbul-lib-report": "^3.0.1",
    "js-yaml": "^4.2.0",
    "jscpd": "^5.0.12",
    "jsdom": "29.1.1",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "lightningcss": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.16.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "^0.3.21",
    "smol-toml": "^1.7.1",
    "spdx-expression-parse": "^5.0.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@ejunz/app-boot": "workspace:^",
    "@ejunz/base": "workspace:^",
    "@ejunz/client-connection": "workspace:^",
    "@ejunz/cmdline": "workspace:^",
    "@ejunz/command-compact": "workspace:^",
    "@ejunz/command-goal": "workspace:^",
    "@ejunz/compaction-basic": "workspace:^",
    "@ejunz/compaction-tool-result-pruner": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/cordis-plugin-hmr": "workspace:^",
    "@ejunz/cordis-plugin-include": "workspace:^",
    "@ejunz/cordis-plugin-loader": "workspace:^",
    "@ejunz/cordis-plugin-logger-console": "workspace:^",
    "@ejunz/cordis-plugin-timer": "workspace:^",
    "@ejunz/credentials": "workspace:^",
    "@ejunz/goal": "workspace:^",
    "@ejunz/goal-round-driver": "workspace:^",
    "@ejunz/headless": "workspace:^",
    "@ejunz/home-paths": "workspace:^",
    "@ejunz/host-apiproxy": "workspace:^",
    "@ejunz/jobs-local": "workspace:^",
    "@ejunz/launch-environment": "workspace:^",
    "@ejunz/persona": "workspace:^",
    "@ejunz/plan-mode": "workspace:^",
    "@ejunz/schedule": "workspace:^",
    "@ejunz/session-projection": "workspace:^",
    "@ejunz/session-reference": "workspace:^",
    "@ejunz/skill": "workspace:^",
    "@ejunz/time-context": "workspace:^",
    "@ejunz/token-meter": "workspace:^",
    "@ejunz/tool-ask-user": "workspace:^",
    "@ejunz/tool-goal": "workspace:^",
    "@ejunz/tool-host": "workspace:^",
    "@ejunz/tool-jobs": "workspace:^",
    "@ejunz/tool-skill": "workspace:^",
    "@ejunz/tool-todo": "workspace:^",
    "@ejunz/tool-web": "workspace:^",
    "@ejunz/tool-workflow": "workspace:^",
    "@ejunz/web-app": "workspace:^",
    "@ejunz/workflow-worker-thread": "workspace:^",
    "commander": "^15.0.0",
    "js-yaml": "^4.2.0",
    "katex": "^0.16.25",
    "markdown-it": "^14.1.0",
    "node-addon-require-builtin": "^0.1.4",
    "shiki": "^4.4.3",
    "ws": "^8.18.3"
  },
  "description": "ea CLI: profile boot, plugin management, and the browser UI alias",
  "exports": {
    "./embed": {
      "types": "./lib/types/entry/embed.d.ts",
      "default": "./lib/embed.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "."
  },
  "bin": "bin/ea.js",
  "files": [
    "bin/ea.js",
    "bin/postinstall.js",
    "lib/*.js",
    "lib/types/entry/embed.d.ts",
    "lib/types/service/embed.d.ts",
    "lib/types/service/host-tools.d.ts",
    "config"
  ]
}
