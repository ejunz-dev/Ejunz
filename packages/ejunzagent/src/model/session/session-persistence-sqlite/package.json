{
  "name": "@ejunz/session-persistence-sqlite",
  "description": "SQLite durable session persistence backend for the EjunzAgent",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "src/model/session/session-persistence-sqlite"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/types/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/session-persistence": "workspace:^"
  },
  "dependencies": {
    "@ejunz/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/session": "workspace:^",
    "@ejunz/session-persistence": "workspace:^"
  }
}
