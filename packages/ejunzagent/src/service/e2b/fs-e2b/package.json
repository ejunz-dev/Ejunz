{
  "name": "@ejunz/fs-e2b",
  "description": "E2B filesystem implementation for EjunzAgent",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "src/service/e2b/fs-e2b"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/types/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/cordis": "workspace:^",
    "@ejunz/e2b": "workspace:^",
    "@ejunz/fs": "workspace:^",
    "@ejunz/invariants": "workspace:^"
  },
  "devDependencies": {
    "@ejunz/cordis": "workspace:^",
    "@ejunz/e2b": "workspace:^",
    "@ejunz/fs": "workspace:^",
    "@ejunz/invariants": "workspace:^"
  }
}
