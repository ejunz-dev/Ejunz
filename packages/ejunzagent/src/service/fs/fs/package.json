{
  "name": "@ejunz/fs",
  "description": "Abstract filesystem capability seam (ctx.fs) for the EjunzAgent — vocabulary types, the FileSystem service (text IO + optional version-guarded atomic mutations), and the fs/* policy event vocabulary",
  "version": "0.1.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejunz-dev/ejunz-agent.git",
    "directory": "src/service/fs/fs"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/types/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@ejunz/brand": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^"
  },
  "devDependencies": {
    "@ejunz/brand": "workspace:^",
    "@ejunz/cordis": "workspace:^",
    "@ejunz/invariants": "workspace:^",
    "@ejunz/llm": "workspace:^"
  }
}
