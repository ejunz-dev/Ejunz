{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types/host",
    "tsBuildInfoFile": "lib/tsconfig.host.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/api/gateway/src/client/**",
    "src/api/remotes/src/client/**",
    "src/client/connection/src/client/**",
    "src/client/runtime/src/**",
    "src/**/tests/**"
  ],
  "references": [
