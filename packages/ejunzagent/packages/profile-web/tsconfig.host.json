      "path": "../../tsconfig.flat-modules.json"
    },
    {
      "path": "../../src/vendor/cordis"
    },
    {
      "path": "../../src/vendor/cosmokit"
    },
    {
      "path": "../../src/vendor/loader"
    },
    {
      "path": "../../src/vendor/schemastery"
    }
  ]
