{
  "extends": "../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types/client",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "include": [
    "src/api/gateway/src/client/index.ts",
    "src/api/gateway/src/types.ts",
    "src/api/remotes/src/client/index.ts",
    "src/api/remotes/src/remote-events.ts",
    "src/api/remotes/src/types.ts",
    "src/client/connection/src/api-path.ts",
